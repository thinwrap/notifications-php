{
    "name": "thinwrap/notifications",
    "description": "Unified PHP facade over 35 notification providers across Email / SMS / Push / Chat — baseline-coverage discipline.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "notifications",
        "email",
        "sms",
        "push",
        "chat",
        "ses",
        "resend",
        "mailgun",
        "sendgrid",
        "postmark",
        "twilio",
        "vonage",
        "plivo",
        "fcm",
        "apns",
        "expo",
        "telegram",
        "slack",
        "discord",
        "whatsapp-business",
        "thinwrap",
        "wrapper",
        "sdk-free",
        "stateless",
        "psr-18"
    ],
    "homepage": "https://thinwrap.dev",
    "support": {
        "issues": "https://github.com/thinwrap/notifications-php/issues",
        "source": "https://github.com/thinwrap/notifications-php"
    },
    "authors": [
        {
            "name": "Thinwrap maintainers",
            "homepage": "https://github.com/thinwrap"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "php-http/discovery": "^1.20"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1.54",
        "friendsofphp/php-cs-fixer": "^3.95",
        "php-http/mock-client": "^1.6",
        "nyholm/psr7": "^1.8",
        "guzzlehttp/psr7": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "Thinwrap\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thinwrap\\Notifications\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
